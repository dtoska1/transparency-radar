---
import BaseLayout from '../layouts/BaseLayout.astro';
import { adminApiFetch, relaySetCookies } from '../lib/apiClient';

let authenticated = false;
let serviceUnavailable = false;

try {
  const response = await adminApiFetch('/api/admin/pending?limit=1', {
    cookieHeader: Astro.request.headers.get('cookie'),
  });
  relaySetCookies(response, Astro.response.headers);

  if (response.status === 401) {
    return Astro.redirect('/login');
  }

  authenticated = response.ok;
  serviceUnavailable = !response.ok;
} catch {
  serviceUnavailable = true;
}
---

<BaseLayout title="Admin">
  <main class="mx-auto min-h-screen max-w-6xl px-6 py-10">
    {
      authenticated ? (
        <>
          <header class="flex items-start justify-between border-b border-slate-200 pb-6">
            <div>
              <p class="text-sm font-semibold text-navy-700">Radari Vendor</p>
              <h1 class="mt-2 text-2xl font-semibold">Authenticated</h1>
            </div>
            <form method="post" action="/api/logout">
              <button
                class="border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800 hover:bg-slate-50"
                type="submit">Sign out</button
              >
            </form>
          </header>
          <p class="mt-8 text-sm text-slate-600">
            The protected admin API call succeeded. Panel screens arrive in a later phase.
          </p>
        </>
      ) : (
        serviceUnavailable && (
          <section>
            <p class="text-sm font-semibold text-navy-700">Radari Vendor</p>
            <h1 class="mt-2 text-2xl font-semibold">Admin unavailable</h1>
            <p class="mt-3 text-sm text-slate-600">The admin service could not be reached.</p>
          </section>
        )
      )
    }
  </main>
</BaseLayout>
