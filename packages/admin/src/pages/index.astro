---
import AdminShell from '../components/AdminShell.astro';
import ReviewQueueTable from '../components/ReviewQueueTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { adminApiFetch, relaySetCookies } from '../lib/apiClient';
import { parseReviewNotice } from '../lib/reviewActions';
import {
  MUNICIPALITIES,
  type PendingRow,
  QUEUE_PAGE_SIZE,
  VERTICALS,
  buildPendingApiPath,
  buildQueuePageUrl,
  municipalityLabel,
  paginatePendingRows,
  parsePendingEnvelope,
  parseQueueFilters,
  verticalLabel,
} from '../lib/reviewQueue';

let authenticated = false;
let serviceUnavailable = false;
let rows: PendingRow[] = [];
let hasNext = false;
const filters = parseQueueFilters(Astro.url.searchParams);
const notice = parseReviewNotice(Astro.url.searchParams);

try {
  const response = await adminApiFetch(buildPendingApiPath(filters), {
    cookieHeader: Astro.request.headers.get('cookie'),
  });
  relaySetCookies(response, Astro.response.headers);

  if (response.status === 401) {
    return Astro.redirect('/login');
  }

  if (response.ok) {
    const envelope = parsePendingEnvelope(await response.json());
    const page = paginatePendingRows(envelope.data);
    rows = page.rows;
    hasNext = page.hasNext;
    authenticated = true;
  } else {
    serviceUnavailable = true;
  }
} catch {
  serviceUnavailable = true;
}

const previousUrl = buildQueuePageUrl(filters, Math.max(0, filters.offset - QUEUE_PAGE_SIZE));
const nextUrl = buildQueuePageUrl(filters, filters.offset + QUEUE_PAGE_SIZE);
const filtersActive = Boolean(filters.vertical || filters.municipality);
---

<BaseLayout title="Review Queue">
  {
    authenticated ? (
      <AdminShell pendingCount={rows.length}>
        <main class="mx-auto max-w-[1500px] px-4 py-6 sm:px-6 lg:px-8">
          <header class="mb-5 flex flex-wrap items-end gap-4">
            <div>
              <h1 class="text-xl font-semibold text-navy-950">Review Queue</h1>
              <p class="mt-1 text-sm text-slate-500">
                <b class="font-mono font-semibold text-amber-700">{rows.length}</b> pending documents
                shown
                {filters.offset > 0 ? ` · offset ${filters.offset} per vertical` : ''}
              </p>
            </div>
            <div class="ml-auto flex items-center gap-2 text-xs text-slate-500">
              <span class="size-2 bg-emerald-600" aria-hidden="true" />
              Tamper-evidence shown from linked source records
            </div>
          </header>

          <form
            class="mb-4 flex flex-wrap items-end gap-3 border-y border-slate-200 bg-white px-4 py-3"
            method="get"
            action="/"
          >
            <label class="block">
              <span class="mb-1 block text-[10px] font-semibold uppercase text-slate-500">
                Municipality
              </span>
              <select
                class="h-9 min-w-44 border border-slate-300 bg-white px-3 text-sm text-slate-800 outline-none focus:border-navy-700"
                name="municipality"
              >
                <option value="">All municipalities</option>
                {MUNICIPALITIES.map((municipality) => (
                  <option value={municipality} selected={filters.municipality === municipality}>
                    {municipalityLabel(municipality)}
                  </option>
                ))}
              </select>
            </label>

            <label class="block">
              <span class="mb-1 block text-[10px] font-semibold uppercase text-slate-500">
                Vertical
              </span>
              <select
                class="h-9 min-w-40 border border-slate-300 bg-white px-3 text-sm text-slate-800 outline-none focus:border-navy-700"
                name="vertical"
              >
                <option value="">All verticals</option>
                {VERTICALS.map((vertical) => (
                  <option value={vertical} selected={filters.vertical === vertical}>
                    {verticalLabel(vertical)}
                  </option>
                ))}
              </select>
            </label>

            <button
              class="h-9 bg-navy-800 px-4 text-sm font-semibold text-white hover:bg-navy-700"
              type="submit"
            >
              Apply filters
            </button>
            {filtersActive && (
              <a
                class="inline-flex h-9 items-center border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
                href="/"
              >
                Clear
              </a>
            )}
          </form>

          {notice && (
            <div
              class:list={[
                'mb-4 border px-4 py-3 text-sm font-medium',
                notice.kind === 'success' && 'border-emerald-200 bg-emerald-50 text-emerald-800',
                notice.kind === 'warning' && 'border-amber-200 bg-amber-50 text-amber-800',
                notice.kind === 'error' && 'border-rose-200 bg-rose-50 text-rose-800',
              ]}
              role="status"
            >
              {notice.text}
            </div>
          )}

          <ReviewQueueTable rows={rows} filters={filters} />

          <nav class="mt-4 flex items-center justify-between" aria-label="Queue pagination">
            <div>
              {filters.offset > 0 && (
                <a
                  class="inline-flex h-9 items-center border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                  href={previousUrl}
                >
                  Previous
                </a>
              )}
            </div>
            <p class="text-xs text-slate-500">20 rows per included vertical</p>
            <div>
              {hasNext && (
                <a
                  class="inline-flex h-9 items-center bg-navy-800 px-4 text-sm font-semibold text-white hover:bg-navy-700"
                  href={nextUrl}
                >
                  Next
                </a>
              )}
            </div>
          </nav>
        </main>
      </AdminShell>
    ) : (
      serviceUnavailable && (
        <main class="grid min-h-screen place-items-center px-6 py-12">
          <section class="w-full max-w-md border border-slate-200 bg-white px-6 py-8">
            <p class="text-sm font-semibold text-navy-700">Radari Vendor</p>
            <h1 class="mt-2 text-2xl font-semibold">Admin unavailable</h1>
            <p class="mt-3 text-sm text-slate-600">The admin service could not be reached.</p>
          </section>
        </main>
      )
    )
  }
</BaseLayout>
