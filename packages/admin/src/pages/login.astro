---
import BaseLayout from '../layouts/BaseLayout.astro';

const loginFailed = Astro.url.searchParams.has('error');
---

<BaseLayout title="Sign in">
  <main class="grid min-h-screen place-items-center px-6 py-12">
    <section class="w-full max-w-sm">
      <p class="text-sm font-semibold text-navy-700">Radari Vendor</p>
      <h1 class="mt-2 text-2xl font-semibold">Admin sign in</h1>
      <p class="mt-2 text-sm text-slate-600">Use your administrator account to continue.</p>

      {
        loginFailed && (
          <p class="mt-6 border-l-2 border-red-600 bg-red-50 px-4 py-3 text-sm text-red-800">
            Sign in failed. Check your credentials and try again.
          </p>
        )
      }

      <form class="mt-8 space-y-5" method="post" action="/api/login">
        <label class="block text-sm font-medium text-slate-800">
          Email
          <input
            class="mt-2 block w-full border border-slate-300 bg-white px-3 py-2 text-base outline-none focus:border-navy-700"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
        </label>

        <label class="block text-sm font-medium text-slate-800">
          Password
          <input
            class="mt-2 block w-full border border-slate-300 bg-white px-3 py-2 text-base outline-none focus:border-navy-700"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          />
        </label>

        <button
          class="w-full bg-navy-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-navy-700"
          type="submit">Sign in</button
        >
      </form>
    </section>
  </main>
</BaseLayout>
