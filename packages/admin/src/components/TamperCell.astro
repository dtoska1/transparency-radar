---
import { type PendingRow, formatTimestamp, shortHash } from '../lib/reviewQueue';

interface Props {
  row: PendingRow;
}

const { row } = Astro.props;
---

{
  row.stamped && row.sha256 ? (
    <div
      class="min-w-44"
      title={`SHA-256: ${row.sha256}${row.tsr_timestamp_at ? `\nRFC-3161: ${row.tsr_timestamp_at}` : ''}`}
    >
      <div class="flex items-center gap-2">
        <span
          class="grid size-5 place-items-center border border-emerald-200 bg-emerald-50 text-xs font-bold text-emerald-700"
          aria-hidden="true"
        >
          ✓
        </span>
        <span class="text-xs font-semibold text-emerald-800">Stamped</span>
      </div>
      <p class="mt-1 font-mono text-[11px] text-slate-600">{shortHash(row.sha256)}</p>
      <p class="mt-0.5 text-[10px] text-slate-500">
        {row.tsr_timestamp_at ? `RFC 3161 · ${formatTimestamp(row.tsr_timestamp_at)}` : 'Timestamp unavailable'}
      </p>
    </div>
  ) : (
    <div class="min-w-44" title="No linked SHA-256 document record">
      <div class="flex items-center gap-2">
        <span
          class="grid size-5 place-items-center border border-dashed border-amber-300 bg-amber-50 text-xs font-bold text-amber-800"
          aria-hidden="true"
        >
          !
        </span>
        <span class="text-xs font-semibold text-amber-800">Not stamped</span>
      </div>
      <p class="mt-1 text-[11px] text-amber-700">No SHA-256 record</p>
    </div>
  )
}
