# Site block for radarvendor.com — serves packages/site/ as static files on the VPS.
# Not auto-applied: paste into the real Caddyfile and `caddy reload` manually.
# Replaces packages/site/staticwebapp.config.json, which was an Azure Static Web Apps
# format with no effect under Caddy — these are the same security headers, carried
# forward and updated for the live API call + Google Fonts this page now needs.

radarvendor.com {
    root * /var/www/radarvendor.com   # <-- REPLACE with the real static-files directory
    file_server
    encode gzip

    header {
        Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; connect-src 'self' https://api.radarvendor.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'"
        Permissions-Policy "camera=(), geolocation=(), microphone=()"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
